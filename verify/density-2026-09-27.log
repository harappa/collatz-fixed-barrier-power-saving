== script ==
import Lean
open Lean

def closureOf (env : Environment) (roots : Array Name) : IO NameSet := do
  let mut seen : NameSet := {}
  let mut stack := roots
  while stack.size > 0 do
    let n := stack.back!
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    match env.find? n with
    | none => throw <| IO.userError s!"missing constant {n}"
    | some ci =>
      for m in ci.getUsedConstantsAsSet do
        unless seen.contains m do stack := stack.push m
      match ci with
      | .inductInfo v =>
        for c in v.ctors do stack := stack.push c
        for a in v.all do stack := stack.push a
      | .ctorInfo v => stack := stack.push v.induct
      | .recInfo v => for a in v.all do stack := stack.push a
      | _ => pure ()
  return seen

unsafe def main (_ : List String) : IO UInt32 := do
  initSearchPath (← findSysroot)
  let env ← importModules #[{module := `CollatzND.Core.Density}] {} (trustLevel := 0) (loadExts := false)
  let roots : Array Name := #[`Collatz.nd_collatz_uniform_explicit, `Collatz.nd_collatz_uniform,
    `Collatz.tstarExponent_eq, `Collatz.tstarExponent_pos,
    `FirstPassageLinearTransport.FixedBarrier.fixedBarrier_failure_count,
    `Collatz.nd_collatz_corollaries, `Collatz.nd_density_one,
    `Collatz.lt_colMin_iff, `Collatz.colMin_lt_iff]
  let cl ← closureOf env roots
  IO.println s!"closure size: {cl.size}"
  let mut mods : Array Name := #[]
  for m in env.header.moduleNames do
    if (`CollatzND.Core).isPrefixOf m || (`CollatzProof.Core).isPrefixOf m ||
        (`CollatzND).isPrefixOf m || (`CollatzProof).isPrefixOf m then
      mods := mods.push m
  IO.println s!"project modules loaded ({mods.size}): {mods}"
  let mut count := 0
  let mut unused : Array Name := #[]
  let mut eqns : Array Name := #[]
  let mut densityDecls : Array Name := #[]
  for (n, _) in env.constants.map₁.toList do
    match env.getModuleIdxFor? n with
    | some idx =>
      let mod := env.header.moduleNames[idx.toNat]!
      if ((`CollatzND).isPrefixOf mod || (`CollatzProof).isPrefixOf mod) && !n.isInternal then
        count := count + 1
        unless cl.contains n do
          -- equation lemmas (`f.eq_1`, `f.eq_def`) are generated on demand by `unfold`/`simp`, not declared by hand
          let isEqn := match n with
            | .str _ s => s.startsWith "eq_" || s == "eq_def"
            | _ => false
          if isEqn then eqns := eqns.push n else unused := unused.push n
        if mod == `CollatzND.Core.Density then densityDecls := densityDecls.push n
    | none => pure ()
  IO.println s!"project declarations (non-internal): {count}"
  IO.println s!"declarations of CollatzND.Core.Density ({densityDecls.size}): {densityDecls.qsort (·.toString < ·.toString)}"
  IO.println s!"generated equation lemmas outside the closure: {eqns}"
  IO.println s!"project declarations outside the closure of the roots: {unused}"
  return (if unused.isEmpty then 0 else 1)
