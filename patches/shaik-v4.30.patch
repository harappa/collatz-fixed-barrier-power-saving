@@ -0,0 +1,508 @@
+/-
+Fixed-barrier failure bound, assembled from the library's existing lemmas.
+It is a fixed-target counterpart of the estimate behind Theorem 5.3 of the
+paper; the statement below is not a theorem of the paper.
+
+This file is an addition to the ported copy of Idris Ali Shaik's
+`FirstPassageLinearTransport` formalization (Apache-2.0).  It does not change
+any existing declaration.
+-/
+import FirstPassageLinearTransport.TerminalTailAsymptotics
+import FirstPassageLinearTransport.Parameters
+
+/-!
+# Fixed-barrier failure bound with a fixed target rank
+
+The library proves the two deterministic facts of Section 5 (nested direct
+first passage, `CertifiedRankChain.directFirstPassage`, and the rank-scaled
+reverse-loss budget, `CertifiedRankChain.scaledReverseLoss_le`), the literal
+re-certification run `RecertificationRun`, its conversion to a generated
+first-bad witness, and the terminal profile of the generated first-bad sources
+(`generatedFirstBadSources_density_terminalProfile`).
+
+What is added here is the semantic step of the proof of Theorem 5.3 for the
+fixed barrier: every source of the shell `[2^M, 2^(M+1))` whose shortcut orbit
+does not go below `2^L` up to time `H` (with `M ≤ (1-r)H`) either fails the
+initial certification or carries a generated first-bad landing at some rank in
+`[L, M-1]` within time `H` (`neverBelow_subset_failure`).  The time bound is
+the paper's (5.6), proved here through the invariant
+`(1-r)·elapsed + q ≤ M` (`run_elapsed_budget`).
+
+The parameters are fixed once and for all: `r = 7/8` (so `H = 8M`),
+`eta = 1/16`, and the entropy barrier of `AdjustableBarrierDensity` with
+`lambda = 1/2`.  Hence all constants in `fixedBarrier_failure_count_timed`,
+`fixedBarrier_failure_count_linear` and `fixedBarrier_failure_count` are
+absolute.  The rate is the explicit `fbFixedRate = min (fbRate/2) (log 2/2)`;
+the `_rate` forms state it, and the existential forms are corollaries.
+-/
+
+namespace FirstPassageLinearTransport
+
+namespace FixedBarrier
+
+open scoped BigOperators
+
+noncomputable section
+
+/-! ## Invariant along a re-certification run -/
+
+/-- Cumulative-time invariant of a certified run started in shell `M`:
+`(1 - r) * elapsed + q ≤ M`.  This is the paper's estimate (5.6) in a form
+that survives the induction. -/
+theorem run_elapsed_budget
+    {r : ℚ} {eta : ℝ} {p : StageSetup (r : ℝ) eta} {n elapsed q M : ℕ}
+    (hrun : RecertificationRun p n elapsed q) (hnShell : n ∈ dyadicShell M) :
+    (1 - (r : ℝ)) * (elapsed : ℝ) + (q : ℝ) ≤ (M : ℝ) := by
+  have hr0 : (0 : ℝ) ≤ (r : ℝ) := p.r_pos.le
+  have hr1 : (r : ℝ) < 1 := p.r_lt_one
+  have hgap : (0 : ℝ) ≤ 1 - (r : ℝ) := by linarith
+  induction hrun with
+  | @first m hm0 hnShell' hnGood =>
+      have hmM : m = M := by
+        rw [← log_two_eq_of_mem_dyadicShell hnShell',
+          log_two_eq_of_mem_dyadicShell hnShell]
+      subst hmM
+      have hlen : (stageLength p n : ℝ) ≤ (m : ℝ) := by
+        exact_mod_cast stageLength_le_shell p hm0 hnShell' hnGood
+      have hfloor : (rationalTargetRank r m : ℝ) ≤ (r : ℝ) * (m : ℝ) :=
+        Nat.floor_le (by positivity)
+      have hmul := mul_le_mul_of_nonneg_left hlen hgap
+      nlinarith
+  | @next elapsed qprev m hrun hm0 hsourceShell hsourceGood ih =>
+      have hfp := hrun.toCertifiedRankChain.directFirstPassage
+      have hpow : 2 ^ m ≤ 2 ^ qprev :=
+        (mem_dyadicShell.mp hsourceShell).1.trans hfp.1
+      have hmq : m ≤ qprev :=
+        (Nat.pow_le_pow_iff_right (by norm_num)).1 hpow
+      have hmqR : (m : ℝ) ≤ (qprev : ℝ) := by exact_mod_cast hmq
+      have hlen : (stageLength p (orbit elapsed n) : ℝ) ≤ (m : ℝ) := by
+        exact_mod_cast stageLength_le_shell p hm0 hsourceShell hsourceGood
+      have hfloor : (rationalTargetRank r m : ℝ) ≤ (r : ℝ) * (m : ℝ) :=
+        Nat.floor_le (by positivity)
+      have hmul := mul_le_mul_of_nonneg_left hlen hgap
+      have hih := ih
+      push_cast
+      nlinarith
+
+/-! ## The semantic step: never descending forces a first failure -/
+
+/-- A certified run whose source does not go below `2^L` up to time `H` ends,
+after finitely many further certified blocks, in a generated first-bad landing
+at a rank in `[L, M-1]` within the time horizon `H`. -/
+theorem run_firstBad_of_neverBelow
+    {r : ℚ} {eta : ℝ} {p : StageSetup (r : ℝ) eta} {n M L H : ℕ}
+    (hnShell : n ∈ dyadicShell M) (hL : p.M0 ≤ L) (hL1 : 1 ≤ L)
+    (hH : (M : ℝ) ≤ (1 - (r : ℝ)) * (H : ℝ))
+    (hnever : ∀ k : ℕ, k ≤ H → 2 ^ L ≤ orbit k n) :
+    ∀ q elapsed : ℕ, RecertificationRun p n elapsed q →
+      HasGeneratedFirstBadLanding r eta n L (M - 1) H := by
+  have hr0Q : (0 : ℚ) ≤ r := by exact_mod_cast p.r_pos.le
+  have hr1Q : r < 1 := by exact_mod_cast p.r_lt_one
+  have hr1 : (r : ℝ) < 1 := p.r_lt_one
+  intro q
+  induction q using Nat.strong_induction_on with
+  | h q ih =>
+      intro elapsed hrun
+      have hfp := hrun.toCertifiedRankChain.directFirstPassage
+      have hbud := run_elapsed_budget hrun hnShell
+      have hepos : 0 < elapsed := hrun.elapsed_pos
+      have heposR : (0 : ℝ) < (elapsed : ℝ) := by exact_mod_cast hepos
+      have hgap : (0 : ℝ) < 1 - (r : ℝ) := by linarith
+      have hqMR : (q : ℝ) < (M : ℝ) := by nlinarith
+      have hqM : q < M := by exact_mod_cast hqMR
+      have heH : elapsed ≤ H := by
+        have hqR : (0 : ℝ) ≤ (q : ℝ) := Nat.cast_nonneg q
+        have hle : (1 - (r : ℝ)) * (elapsed : ℝ) ≤ (1 - (r : ℝ)) * (H : ℝ) := by
+          linarith
+        have hleR : (elapsed : ℝ) ≤ (H : ℝ) := le_of_mul_le_mul_left hle hgap
+        exact_mod_cast hleR
+      have hxle : orbit elapsed n ≤ 2 ^ q := hfp.1
+      have hxge : 2 ^ L ≤ orbit elapsed n := hnever elapsed heH
+      have hLq : L ≤ q :=
+        (Nat.pow_le_pow_iff_right (by norm_num)).1 (hxge.trans hxle)
+      by_cases hgood : orbit elapsed n ∈ initialWindowGood eta
+      · let x := orbit elapsed n
+        let m := Nat.log 2 x
+        have hxpos : 0 < x := lt_of_lt_of_le (by positivity) hxge
+        have hxshell : x ∈ dyadicShell m := by
+          rw [mem_dyadicShell]
+          exact ⟨Nat.pow_log_le_self 2 hxpos.ne',
+            Nat.lt_pow_succ_log_self (by norm_num) x⟩
+        have hLm : L ≤ m := Nat.le_log_of_pow_le (by norm_num) hxge
+        have hmq : m ≤ q :=
+          (Nat.pow_le_pow_iff_right (by norm_num)).1
+            ((mem_dyadicShell.mp hxshell).1.trans hxle)
+        have hmpos : 0 < m := by omega
+        have hnext : rationalTargetRank r m < q :=
+          (rationalTargetRank_lt_parent hr0Q hr1Q hmpos).trans_le hmq
+        have nextRun := RecertificationRun.next hrun (hL.trans hLm) hxshell hgood
+        exact ih _ hnext _ nextRun
+      · exact hrun.toGeneratedFirstBadLanding hLq (by omega) heH hgood
+
+open scoped Classical in
+/-- Covering of the sources of one shell that do not go below `2^L` up to
+time `H` by the initial certification failures and the generated first-bad
+sources. -/
+theorem neverBelow_subset_failure
+    {r : ℚ} {eta : ℝ} (p : StageSetup (r : ℝ) eta) {M L H : ℕ}
+    (hLM : L ≤ M) (hL : p.M0 ≤ L) (hL1 : 1 ≤ L)
+    (hH : (M : ℝ) ≤ (1 - (r : ℝ)) * (H : ℝ)) :
+    ((dyadicShell M).filter (fun n => ∀ k : ℕ, k ≤ H → 2 ^ L ≤ orbit k n)) ⊆
+      shellInitialWindowBad M eta ∪
+        generatedFirstBadSources M L (M - 1) H r eta := by
+  classical
+  intro n hn
+  rw [Finset.mem_filter] at hn
+  rcases hn with ⟨hnShell, hnever⟩
+  rw [Finset.mem_union]
+  by_cases hgood : n ∈ initialWindowGood eta
+  · right
+    have hrun := RecertificationRun.first (p := p) (hL.trans hLM) hnShell hgood
+    exact mem_generatedFirstBadSources.mpr
+      ⟨hnShell, run_firstBad_of_neverBelow hnShell hL hL1 hH
+        hnever _ _ hrun⟩
+  · left
+    rw [← shellBad_initialWindowGood]
+    unfold shellBad
+    rw [Finset.mem_filter]
+    exact ⟨hnShell, hgood⟩
+
+/-! ## Fixed parameters `r = 7/8`, `eta = 1/16`, `lambda = 1/2` -/
+
+/-- The fixed rational contraction ratio `r = 7/8`. -/
+def fbR : ℚ := 7 / 8
+
+/-- The fixed certification tolerance `eta = 1/16`. -/
+def fbEta : ℝ := 1 / 16
+
+/-- `log₂ 3 < 13/8`, i.e. `3^8 = 6561 < 8192 = 2^13`. -/
+theorem logTwoThree_lt_thirteen_eighths : logTwoThree < 13 / 8 := by
+  unfold logTwoThree
+  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
+  rw [div_lt_iff₀ hlog2]
+  have h : Real.log ((3 : ℝ) ^ 8) < Real.log ((2 : ℝ) ^ 13) :=
+    Real.log_lt_log (by norm_num) (by norm_num)
+  rw [Real.log_pow, Real.log_pow] at h
+  push_cast at h
+  linarith
+
+theorem fbR_cast : ((fbR : ℚ) : ℝ) = 7 / 8 := by
+  unfold fbR
+  norm_num
+
+theorem fbR_pos : (0 : ℚ) < fbR := by
+  unfold fbR
+  norm_num
+
+theorem a0_lt_fbR : a0 < ((fbR : ℚ) : ℝ) := by
+  rw [fbR_cast]
+  unfold a0
+  linarith [logTwoThree_lt_thirteen_eighths]
+
+theorem fbEta_pos : 0 < fbEta := by
+  unfold fbEta
+  norm_num
+
+theorem fbEta_gap : fbEta < ((fbR : ℚ) : ℝ) - a0 := by
+  rw [fbR_cast]
+  unfold fbEta a0
+  linarith [logTwoThree_lt_thirteen_eighths]
+
+theorem fbEta_lt_a0 : fbEta < a0 := by
+  unfold fbEta a0
+  linarith [logTwoThree_one_lt]
+
+/-- The one-stage parameter package for the fixed parameters (Section 5,
+(5.1)-(5.2)); its startup rank `M0` is an absolute constant. -/
+theorem exists_fixedStageSetup :
+    Nonempty (StageSetup ((fbR : ℚ) : ℝ) fbEta) :=
+  exists_stageSetup a0_lt_fbR (by rw [fbR_cast]; norm_num) fbEta_pos fbEta_gap
+
+/-- The entropy rate of the adjustable barrier at `lambda = 1/2`,
+`t = eta = 1/16`. -/
+def fbRate : ℝ :=
+  binaryBarrierRate (adjustableBarrierDisplacement (1 / 2) fbEta)
+
+theorem fbRate_pos : 0 < fbRate := by
+  unfold fbRate binaryBarrierRate
+  apply sub_pos.mpr
+  rw [Real.binEntropy_lt_log_two]
+  have hd : 0 < adjustableBarrierDisplacement (1 / 2) fbEta := by
+    unfold adjustableBarrierDisplacement fbEta
+    exact div_pos (by norm_num) logTwoThree_pos
+  intro h
+  have : adjustableBarrierDisplacement (1 / 2) fbEta = 0 := by
+    norm_num at h
+    linarith
+  linarith
+
+/-- The explicit rate of the fixed-barrier bound. -/
+def fbFixedRate : ℝ := min (fbRate / 2) (Real.log 2 / 2)
+
+theorem fbFixedRate_pos : 0 < fbFixedRate :=
+  lt_min (by have := fbRate_pos; linarith) (by have := Real.log_pos (by norm_num : (1 : ℝ) < 2); linarith)
+
+/-- The reverse-loss budget `(q+2)/r` is small against the threshold `2^q`
+(the paper's (5.13)) for every `q ≥ 5`. -/
+theorem rank_budget_small {q : ℕ} (hq : 5 ≤ q) :
+    ((((q + 2 : ℕ) : ℚ) / fbR) / ((2 ^ q : ℕ) : ℚ)) ≤ 1 / 3 := by
+  have hnat : 24 * (q + 2) ≤ 7 * 2 ^ q := by
+    induction q, hq using Nat.le_induction with
+    | base => norm_num
+    | succ k hk ih =>
+        rw [pow_succ]
+        omega
+  have hQ : (24 : ℚ) * ((q + 2 : ℕ) : ℚ) ≤ 7 * ((2 ^ q : ℕ) : ℚ) := by
+    exact_mod_cast hnat
+  have hpos : (0 : ℚ) < ((2 ^ q : ℕ) : ℚ) := by positivity
+  unfold fbR
+  rw [div_le_iff₀ hpos, div_le_iff₀ (by norm_num)]
+  linarith
+
+/-! ## Assembly -/
+
+open scoped Classical in
+/-- Timed fixed-barrier failure bound with one linear factor in the shell
+rank: the number of `n ∈ [2^M, 2^(M+1))` whose shortcut orbit stays at or
+above `2^L` at every time `k ≤ 8M` is at most `C · 2^M · (M+1) · e^{-cL}`
+with the explicit rate `c = fbFixedRate` and absolute `C, L0`.
+(`8M = M/(1-r)` is the paper's horizon (5.6).) -/
+theorem fixedBarrier_failure_count_timed_rate :
+    ∃ C : ℝ, 0 < C ∧ ∃ L0 : ℕ, ∀ L M : ℕ, L0 ≤ L → L ≤ M →
+      (((dyadicShell M).filter
+          (fun n => ∀ k : ℕ, k ≤ 8 * M → 2 ^ L ≤ orbit k n)).card : ℝ)
+        ≤ C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) := by
+  unfold fbFixedRate
+  obtain ⟨p⟩ := exists_fixedStageSetup
+  have hb : 0 < fbRate := fbRate_pos
+  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
+  have hb' : 0 < fbRate / 2 := by positivity
+  have hbb' : fbRate / 2 < fbRate := by linarith
+  have hc' : 0 < Real.log 2 / 2 := by positivity
+  have hc2 : Real.log 2 / 2 < Real.log 2 := by linarith
+  -- eventual entropy-sharp landing-band bound (all higher ranks at once)
+  obtain ⟨L1, hL1⟩ := Filter.eventually_atTop.1
+    (eventually_interval_card_landingBad_adjustable_le
+      (lambda := 1 / 2) (t := fbEta) (by norm_num) (by norm_num)
+      fbEta_pos fbEta_lt_a0)
+  -- eventual entropy-sharp initial-shell bound
+  obtain ⟨M1, hM1⟩ := Filter.eventually_atTop.1
+    (eventually_card_shellInitialWindowBad_adjustable_le
+      (lambda := 1 / 2) (t := fbEta) (by norm_num) (by norm_num)
+      fbEta_pos fbEta_lt_a0)
+  set P := terminalTailPrefactor fbRate (fbRate / 2) (Real.log 2 / 2) with hPdef
+  have hP : 0 < P := terminalTailPrefactor_pos hb' hbb' hc' hc2
+  set K : ℝ := 1 + 6 / ((fbR : ℚ) : ℝ) with hKdef
+  have hK : 0 < K := by
+    rw [hKdef, fbR_cast]
+    norm_num
+  set c : ℝ := min (fbRate / 2) (Real.log 2 / 2) with hcdef
+  have hc : 0 < c := lt_min hb' hc'
+  refine ⟨2 + 8 * K * P, by positivity,
+    max (max p.M0 L1) (max M1 5), ?_⟩
+  intro L M hL0 hLM
+  have hLp : p.M0 ≤ L := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hL0
+  have hLL1 : L1 ≤ L := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hL0
+  have hMM1 : M1 ≤ M :=
+    le_trans (le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hL0) hLM
+  have hL5 : 5 ≤ L := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hL0
+  have hLone : 1 ≤ L := by omega
+  have hH : (M : ℝ) ≤ (1 - ((fbR : ℚ) : ℝ)) * ((8 * M : ℕ) : ℝ) := by
+    rw [fbR_cast]
+    push_cast
+    linarith
+  -- covering of the failure set
+  have hsub := neverBelow_subset_failure (eta := fbEta) p hLM hLp hLone hH
+  have hcardNat :
+      ((dyadicShell M).filter
+          (fun n => ∀ k : ℕ, k ≤ 8 * M → 2 ^ L ≤ orbit k n)).card ≤
+        (shellInitialWindowBad M fbEta).card +
+          (generatedFirstBadSources M L (M - 1) (8 * M) fbR fbEta).card :=
+    (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
+  have hcard :
+      (((dyadicShell M).filter
+          (fun n => ∀ k : ℕ, k ≤ 8 * M → 2 ^ L ≤ orbit k n)).card : ℝ) ≤
+        ((shellInitialWindowBad M fbEta).card : ℝ) +
+          ((generatedFirstBadSources M L (M - 1) (8 * M) fbR fbEta).card : ℝ) := by
+    exact_mod_cast hcardNat
+  -- the exponential weight
+  set E : ℝ := Real.exp (-(c * (L : ℝ))) with hEdef
+  have hE : 0 < E := Real.exp_pos _
+  have hpowM : (0 : ℝ) < 2 ^ M := by positivity
+  have hLMR : (L : ℝ) ≤ (M : ℝ) := by exact_mod_cast hLM
+  have hL0R : (0 : ℝ) ≤ (L : ℝ) := Nat.cast_nonneg L
+  -- initial certification failures
+  have hA : ((shellInitialWindowBad M fbEta).card : ℝ) ≤ 2 * 2 ^ M * E := by
+    have h0 := hM1 M hMM1
+    have hexp : Real.exp (-((M : ℝ) *
+        binaryBarrierRate (adjustableBarrierDisplacement (1 / 2) fbEta))) ≤ E := by
+      rw [hEdef]
+      apply Real.exp_le_exp.mpr
+      have hcb : c ≤ fbRate := (min_le_left _ _).trans hbb'.le
+      change -((M : ℝ) * fbRate) ≤ -(c * (L : ℝ))
+      have h1 : c * (L : ℝ) ≤ fbRate * (L : ℝ) :=
+        mul_le_mul_of_nonneg_right hcb hL0R
+      have h2 : fbRate * (L : ℝ) ≤ fbRate * (M : ℝ) :=
+        mul_le_mul_of_nonneg_left hLMR hb.le
+      linarith
+    calc
+      ((shellInitialWindowBad M fbEta).card : ℝ) ≤
+          (2 : ℝ) ^ (M + 1) * Real.exp (-((M : ℝ) *
+            binaryBarrierRate (adjustableBarrierDisplacement (1 / 2) fbEta))) := h0
+      _ ≤ (2 : ℝ) ^ (M + 1) * E :=
+        mul_le_mul_of_nonneg_left hexp (by positivity)
+      _ = 2 * 2 ^ M * E := by rw [pow_succ]; ring
+  -- generated first-bad landings (paper Theorem 5.3, terminal profile)
+  have hB : ((generatedFirstBadSources M L (M - 1) (8 * M) fbR fbEta).card : ℝ) ≤
+      2 ^ M * (8 * (M : ℝ) * K * P * E) := by
+    have hsmall : ∀ q ∈ Finset.Icc L (M - 1),
+        ((((q + 2 : ℕ) : ℚ) / fbR) / ((2 ^ q : ℕ) : ℚ)) ≤ 1 / 3 := by
+      intro q hq
+      exact rank_budget_small (hL5.trans (Finset.mem_Icc.mp hq).1)
+    have hlanding : ∀ q ∈ Finset.Icc L (M - 1),
+        ((landingBad q fbEta).card : ℝ) ≤
+          1 + (2 : ℝ) ^ q * Real.exp (-(((q - 1 : ℕ) : ℝ) * fbRate)) :=
+      hL1 L hLL1 (M - 1)
+    have hprof := generatedFirstBadSources_density_terminalProfile
+      (M := M) (L := L) (U := M - 1) (H := 8 * M) (r := fbR) (t := fbEta)
+      fbR_pos (by omega) hLone hsmall hlanding hb' hbb' hc' hc2
+    have htail := terminalTailBound_le_minRate hb' hbb' hc' hc2 L
+    have hHK : (0 : ℝ) ≤ ((8 * M : ℕ) : ℝ) * (1 + 6 / ((fbR : ℚ) : ℝ)) := by
+      rw [fbR_cast]
+      positivity
+    have hdens :
+        ((generatedFirstBadSources M L (M - 1) (8 * M) fbR fbEta).card : ℝ) /
+            (2 : ℝ) ^ M ≤ 8 * (M : ℝ) * K * P * E := by
+      calc
+        ((generatedFirstBadSources M L (M - 1) (8 * M) fbR fbEta).card : ℝ) /
+            (2 : ℝ) ^ M ≤
+            ((8 * M : ℕ) : ℝ) * (1 + 6 / ((fbR : ℚ) : ℝ)) *
+              terminalTailBound fbRate (fbRate / 2) (Real.log 2 / 2) L := hprof
+        _ ≤ ((8 * M : ℕ) : ℝ) * (1 + 6 / ((fbR : ℚ) : ℝ)) *
+              (P * Real.exp (-(c * (L : ℝ)))) :=
+          mul_le_mul_of_nonneg_left htail hHK
+        _ = 8 * (M : ℝ) * K * P * E := by
+          rw [hKdef, hEdef]
+          push_cast
+          ring
+    rw [div_le_iff₀ hpowM] at hdens
+    linarith
+  -- final collection of the two terms
+  have hMR : (0 : ℝ) ≤ (M : ℝ) := Nat.cast_nonneg M
+  have hKP : 0 ≤ 8 * K * P := by positivity
+  have hfinal :
+      2 * 2 ^ M * E + 2 ^ M * (8 * (M : ℝ) * K * P * E) ≤
+        (2 + 8 * K * P) * 2 ^ M * ((M : ℝ) + 1) * E := by
+    have hbase : 0 ≤ 2 ^ M * E := by positivity
+    have hexpand :
+        (2 + 8 * K * P) * 2 ^ M * ((M : ℝ) + 1) * E -
+            (2 * 2 ^ M * E + 2 ^ M * (8 * (M : ℝ) * K * P * E)) =
+          (2 ^ M * E) * (2 * (M : ℝ) + 8 * K * P) := by
+      ring
+    have hnonneg : 0 ≤ (2 ^ M * E) * (2 * (M : ℝ) + 8 * K * P) :=
+      mul_nonneg hbase (by positivity)
+    linarith
+  calc
+    (((dyadicShell M).filter
+          (fun n => ∀ k : ℕ, k ≤ 8 * M → 2 ^ L ≤ orbit k n)).card : ℝ) ≤
+        ((shellInitialWindowBad M fbEta).card : ℝ) +
+          ((generatedFirstBadSources M L (M - 1) (8 * M) fbR fbEta).card : ℝ) := hcard
+    _ ≤ 2 * 2 ^ M * E + 2 ^ M * (8 * (M : ℝ) * K * P * E) := add_le_add hA hB
+    _ ≤ (2 + 8 * K * P) * 2 ^ M * ((M : ℝ) + 1) * E := hfinal
+
+open scoped Classical in
+/-- Untimed form with the explicit rate: the number of `n ∈ [2^M, 2^(M+1))`
+whose shortcut orbit never goes below `2^L` is at most
+`C · 2^M · (M+1) · e^{-cL}` with `c = fbFixedRate`. -/
+theorem fixedBarrier_failure_count_linear_rate :
+    ∃ C : ℝ, 0 < C ∧ ∃ L0 : ℕ, ∀ L M : ℕ, L0 ≤ L → L ≤ M →
+      (((dyadicShell M).filter (fun n => ∀ k : ℕ, 2 ^ L ≤ orbit k n)).card : ℝ)
+        ≤ C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) := by
+  obtain ⟨C, hC, L0, h⟩ := fixedBarrier_failure_count_timed_rate
+  refine ⟨C, hC, L0, ?_⟩
+  intro L M hL hLM
+  have hsub :
+      ((dyadicShell M).filter (fun n => ∀ k : ℕ, 2 ^ L ≤ orbit k n)) ⊆
+        ((dyadicShell M).filter
+          (fun n => ∀ k : ℕ, k ≤ 8 * M → 2 ^ L ≤ orbit k n)) := by
+    intro n hn
+    rw [Finset.mem_filter] at hn ⊢
+    exact ⟨hn.1, fun k _ => hn.2 k⟩
+  have hcard :
+      (((dyadicShell M).filter (fun n => ∀ k : ℕ, 2 ^ L ≤ orbit k n)).card : ℝ) ≤
+        (((dyadicShell M).filter
+          (fun n => ∀ k : ℕ, k ≤ 8 * M → 2 ^ L ≤ orbit k n)).card : ℝ) := by
+    exact_mod_cast Finset.card_le_card hsub
+  exact hcard.trans (h L M hL hLM)
+
+open scoped Classical in
+/-- **Fixed-barrier failure bound with a fixed target rank and the explicit
+rate** `c = fbFixedRate`: there are absolute constants `C > 0` and `L0` such
+that for all `L0 ≤ L ≤ M`, the number of `n ∈ [2^M, 2^(M+1))` whose shortcut
+orbit never goes below `2^L` is at most `C · 2^M · (M+1) · (L+1) · e^{-cL}`.
+(The factor `L+1 ≥ 1` is not needed for the bound; it is kept for the
+assembly that uses this statement.) -/
+theorem fixedBarrier_failure_count_rate :
+    ∃ C : ℝ, 0 < C ∧ ∃ L0 : ℕ, ∀ L M : ℕ, L0 ≤ L → L ≤ M →
+      (((Finset.Ico (2 ^ M) (2 ^ (M + 1))).filter
+          (fun n => ∀ k, 2 ^ L ≤ shortcut^[k] n)).card : ℝ)
+        ≤ C * 2 ^ M * ((M : ℝ) + 1) * ((L : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) := by
+  obtain ⟨C, hC, L0, h⟩ := fixedBarrier_failure_count_linear_rate
+  refine ⟨C, hC, L0, ?_⟩
+  intro L M hL hLM
+  have hlin := h L M hL hLM
+  have hbase : 0 ≤ C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) := by
+    positivity
+  have hL1 : (1 : ℝ) ≤ (L : ℝ) + 1 := by
+    have : (0 : ℝ) ≤ (L : ℝ) := Nat.cast_nonneg L
+    linarith
+  calc
+    (((Finset.Ico (2 ^ M) (2 ^ (M + 1))).filter
+        (fun n => ∀ k, 2 ^ L ≤ shortcut^[k] n)).card : ℝ) =
+        (((dyadicShell M).filter (fun n => ∀ k : ℕ, 2 ^ L ≤ orbit k n)).card : ℝ) :=
+      rfl
+    _ ≤ C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) := hlin
+    _ = C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) * 1 := by ring
+    _ ≤ C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) * ((L : ℝ) + 1) :=
+      mul_le_mul_of_nonneg_left hL1 hbase
+    _ = C * 2 ^ M * ((M : ℝ) + 1) * ((L : ℝ) + 1) * Real.exp (-(fbFixedRate * L)) := by
+      ring
+
+open scoped Classical in
+/-- Timed form with an unspecified rate (corollary of the `_rate` form). -/
+theorem fixedBarrier_failure_count_timed :
+    ∃ C c : ℝ, 0 < C ∧ 0 < c ∧ ∃ L0 : ℕ, ∀ L M : ℕ, L0 ≤ L → L ≤ M →
+      (((dyadicShell M).filter
+          (fun n => ∀ k : ℕ, k ≤ 8 * M → 2 ^ L ≤ orbit k n)).card : ℝ)
+        ≤ C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(c * L)) := by
+  obtain ⟨C, hC, L0, h⟩ := fixedBarrier_failure_count_timed_rate
+  exact ⟨C, fbFixedRate, hC, fbFixedRate_pos, L0, h⟩
+
+open scoped Classical in
+/-- Untimed form with an unspecified rate (corollary of the `_rate` form). -/
+theorem fixedBarrier_failure_count_linear :
+    ∃ C c : ℝ, 0 < C ∧ 0 < c ∧ ∃ L0 : ℕ, ∀ L M : ℕ, L0 ≤ L → L ≤ M →
+      (((dyadicShell M).filter (fun n => ∀ k : ℕ, 2 ^ L ≤ orbit k n)).card : ℝ)
+        ≤ C * 2 ^ M * ((M : ℝ) + 1) * Real.exp (-(c * L)) := by
+  obtain ⟨C, hC, L0, h⟩ := fixedBarrier_failure_count_linear_rate
+  exact ⟨C, fbFixedRate, hC, fbFixedRate_pos, L0, h⟩
+
+open scoped Classical in
+/-- **Fixed-barrier failure bound with a fixed target rank.**
+There are absolute constants `C, c > 0` and `L0` such that for all
+`L0 ≤ L ≤ M`, the number of `n ∈ [2^M, 2^(M+1))` whose shortcut orbit never
+goes below `2^L` is at most `C · 2^M · (M+1) · (L+1) · e^{-cL}`
+(corollary of `fixedBarrier_failure_count_rate`). -/
+theorem fixedBarrier_failure_count :
+    ∃ C c : ℝ, 0 < C ∧ 0 < c ∧ ∃ L0 : ℕ, ∀ L M : ℕ, L0 ≤ L → L ≤ M →
+      (((Finset.Ico (2 ^ M) (2 ^ (M + 1))).filter
+          (fun n => ∀ k, 2 ^ L ≤ shortcut^[k] n)).card : ℝ)
+        ≤ C * 2 ^ M * ((M : ℝ) + 1) * ((L : ℝ) + 1) * Real.exp (-(c * L)) := by
+  obtain ⟨C, hC, L0, h⟩ := fixedBarrier_failure_count_rate
+  exact ⟨C, fbFixedRate, hC, fbFixedRate_pos, L0, h⟩
+
+end
+
+end FixedBarrier
+
+end FirstPassageLinearTransport
