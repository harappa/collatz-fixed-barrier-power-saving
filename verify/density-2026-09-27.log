  Filter.Tendsto f Filter.atTop Filter.atTop →
    Filter.Tendsto (fun X => ↑{N ∈ Finset.Icc 1 X | ∃ m, ↑(Collatz.col^[m] N) < f N}.card / ↑X) Filter.atTop (nhds 1)
Collatz.nd_collatz_corollaries : ∃ K,
  0 < K ∧
    (∀ (N0 : ℕ),
        1 ≤ N0 →
          ∀ (X : ℕ),
            ↑{N ∈ Finset.Icc 1 X | ∀ (m : ℕ), N0 < Collatz.col^[m] N}.card ≤ K * ↑N0 ^ (-Collatz.tstarExponent) * ↑X) ∧
      (∀ (N0 : ℕ),
          1 ≤ N0 →
            (Filter.IsBoundedUnder (fun x1 x2 => x1 ≤ x2) Filter.atTop fun X =>
                ↑{N ∈ Finset.Icc 1 X | ∀ (m : ℕ), N0 < Collatz.col^[m] N}.card / ↑X) ∧
              Filter.limsup (fun X => ↑{N ∈ Finset.Icc 1 X | ∀ (m : ℕ), N0 < Collatz.col^[m] N}.card / ↑X)
                  Filter.atTop ≤
                K * ↑N0 ^ (-Collatz.tstarExponent)) ∧
        ∀ (θ : ℝ),
          0 < θ →
            ∀ (X : ℝ),
              1 ≤ X →
                ↑{N ∈ Finset.Icc 1 ⌊X⌋₊ | ∀ (m : ℕ), X ^ θ < ↑(Collatz.col^[m] N)}.card ≤
                  2 ^ Collatz.tstarExponent * K * X ^ (1 - θ * Collatz.tstarExponent)
Collatz.colMin_lt_iff : ∀ (y : ℝ) (N : ℕ), ↑(Collatz.colMin N) < y ↔ ∃ m, ↑(Collatz.col^[m] N) < y
Collatz.lt_colMin_iff : ∀ (b : ℝ) (N : ℕ), b < ↑(Collatz.colMin N) ↔ ∀ (m : ℕ), b < ↑(Collatz.col^[m] N)
